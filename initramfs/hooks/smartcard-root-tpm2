#!/bin/sh

# TPM2 workflow hook for luks-root-smartcard.
# Copies assets needed by the systemd-tpm2 decrypt path only.

set -e

PREREQ="cryptroot"

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Source shared libraries - try multiple paths for build-time flexibility
_source_lib() {
    if [ -f "/usr/share/luks-root-smartcard/$1" ]; then
        . "/usr/share/luks-root-smartcard/$1"
    elif [ -f "scripts/$1" ]; then
        . "scripts/$1"
    else
        echo "ERROR: Cannot find $1" >&2
        return 1
    fi
}

_source_lib "smartcard-common-lib.sh"

# Asset inclusion mode, evaluated at initramfs generation time.
#   all      - include this workflow's assets unconditionally (default)
#   detected - include only when a matching token is in the root LUKS2 header
# Override persistently via /etc/luks-root-smartcard/initramfs.conf, or per-run
# via the SMARTCARD_INITRAMFS_INCLUDE environment variable.
_load_inclusion_config "SMARTCARD_INITRAMFS_INCLUDE" "all"

if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ] && ! _uses_token_type "systemd-tpm2"; then
    exit 0
fi

RV=0

if ! _copy_cryptsetup_plugin copy_exec "systemd-tpm2"; then
    echo "WARNING: systemd TPM2 cryptsetup token plugin not found, TPM2 token unlock will not work" >&2
    if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ]; then RV=1; fi
fi

# Copy TSS2 libraries — libsystemd-shared dlopen's these at runtime so they
# do not appear in ldd output and must be copied explicitly.
for _tss2lib in \
    libtss2-esys.so.0 \
    libtss2-mu.so.0 \
    libtss2-rc.so.0 \
    libtss2-sys.so.1 \
    libtss2-tctildr.so.0 \
    libtss2-tcti-device.so.0; do
    for _libdir in /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib64 /usr/lib; do
        _tss2path="$_libdir/$_tss2lib"
        if [ -f "$_tss2path" ]; then
            copy_exec "$_tss2path"
            break
        fi
    done
done

for mod in tpm tpm_tis tpm_tis_core tpm_crb; do
    manual_add_modules "$mod" 2>/dev/null || true
done

exit $RV
