#!/bin/sh

# FIDO2 workflow hook for luks-root-smartcard.
# Copies assets needed by the systemd-fido2 decrypt path only.

set -e

PREREQ="cryptroot"

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Source shared libraries - try multiple paths for build-time flexibility
_source_lib() {
    if [ -f "/usr/share/luks-root-smartcard/$1" ]; then
        . "/usr/share/luks-root-smartcard/$1"
    elif [ -f "scripts/$1" ]; then
        . "scripts/$1"
    else
        echo "ERROR: Cannot find $1" >&2
        return 1
    fi
}

_source_lib "smartcard-common-lib.sh"

# Asset inclusion mode, evaluated at initramfs generation time.
#   all      - include this workflow's assets unconditionally (default)
#   detected - include only when a matching token is in the root LUKS2 header
_load_inclusion_config "SMARTCARD_INITRAMFS_INCLUDE" "all"

if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ] && ! _uses_token_type "systemd-fido2"; then
    exit 0
fi

RV=0

if ! _copy_cryptsetup_plugin copy_exec "systemd-fido2"; then
    echo "WARNING: systemd FIDO2 cryptsetup token plugin not found, FIDO2 token unlock will not work" >&2
    if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ]; then RV=1; fi
fi

# fido2-token enables reliable authenticator presence detection at boot.
_f2t="$(_find_binary_path /usr/bin/fido2-token /bin/fido2-token /usr/local/bin/fido2-token)"
if [ -n "$_f2t" ]; then
    copy_exec "$_f2t"
fi

# Copy libfido2 explicitly — systemd loads this via dlopen at runtime.
_fido2_copied=false
for _fido2 in /usr/lib/*/libfido2.so.* /lib/*/libfido2.so.* /usr/lib64/libfido2.so.* /lib64/libfido2.so.*; do
    [ -f "$_fido2" ] || continue
    copy_exec "$_fido2"
    _fido2_copied=true
    _copy_ldd_deps copy_exec "$_fido2"
    break
done

if [ "$_fido2_copied" = false ]; then
    echo "WARNING: libfido2 not found, FIDO2 token unlock will not work" >&2
    if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ]; then RV=1; fi
fi

for mod in hid hid_generic usbhid hidraw; do
    manual_add_modules "$mod" 2>/dev/null || true
done

exit $RV