#!/bin/sh

# PKCS#11 workflow hook for luks-root-smartcard.
# Copies assets needed by the systemd-pkcs11 decrypt path only.

set -e

PREREQ="cryptroot"

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Source shared libraries - try multiple paths for build-time flexibility
_source_lib() {
    if [ -f "/usr/share/luks-root-smartcard/$1" ]; then
        . "/usr/share/luks-root-smartcard/$1"
    elif [ -f "scripts/$1" ]; then
        . "scripts/$1"
    else
        echo "ERROR: Cannot find $1" >&2
        return 1
    fi
}

_source_lib "smartcard-common-lib.sh"

# Asset inclusion mode, evaluated at initramfs generation time.
#   all      - include this workflow's assets unconditionally (default)
#   detected - include only when a matching token is in the root LUKS2 header
_load_inclusion_config "SMARTCARD_INITRAMFS_INCLUDE" "all"

if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ] && ! _uses_token_type "systemd-pkcs11"; then
    exit 0
fi

RV=0

if [ -x /usr/bin/base64 ]; then
    copy_exec /usr/bin/base64
fi
if [ -x /usr/bin/openssl ]; then
    copy_exec /usr/bin/openssl
fi

if [ -x /usr/bin/pkcs11-tool ]; then
    copy_exec /usr/bin/pkcs11-tool
else
    echo "WARNING: pkcs11-tool not found, PKCS#11 token unlock will not work" >&2
fi

# Prefer the native cryptsetup systemd-pkcs11 token plugin when present.
if ! _copy_cryptsetup_plugin copy_exec "systemd-pkcs11"; then
    echo "WARNING: systemd PKCS#11 cryptsetup token plugin not found, plugin unlock will not work" >&2
fi

# p11-kit metadata is required so the plugin can resolve the OpenSC provider.
[ -d /usr/share/p11-kit/modules ] && cp -a /usr/share/p11-kit/modules "$DESTDIR/usr/share/p11-kit/" 2>/dev/null || true
[ -d /etc/pkcs11/modules ] && cp -a /etc/pkcs11/modules "$DESTDIR/etc/pkcs11/" 2>/dev/null || true

# Include p11-kit proxy libraries loaded indirectly by the cryptsetup plugin.
for p11 in /usr/lib/*/p11-kit-proxy.so /usr/lib/*/pkcs11/p11-kit-trust.so /usr/lib64/p11-kit-proxy.so; do
    [ -f "$p11" ] || continue
    copy_exec "$p11"
done

# OpenSC module is loaded by pkcs11-tool via dlopen(3), so copy it explicitly.
for mod in \
    /usr/lib/*/opensc-pkcs11.so \
    /usr/lib/pkcs11/opensc-pkcs11.so \
    /usr/lib64/pkcs11/opensc-pkcs11.so; do
    [ -f "$mod" ] && copy_exec "$mod"
done

# OpenSC runtime data/config (drivers, ATR map, defaults).
[ -d /usr/share/opensc ] && cp -a /usr/share/opensc "$DESTDIR/usr/share/" 2>/dev/null || true
for cfg in /etc/opensc.conf /etc/opensc; do
    [ -e "$cfg" ] && cp -a "$cfg" "$DESTDIR/etc/" 2>/dev/null || true
done

if [ -x /usr/sbin/pcscd ]; then
    copy_exec /usr/sbin/pcscd

    mkdir -p -- "$DESTDIR/usr/lib/pcsc"
    cp -rt "$DESTDIR/usr/lib" /usr/lib/pcsc

    cp -t "$DESTDIR/etc" /etc/reader.conf 2>/dev/null || true
    if [ -d /etc/reader.conf.d ]; then
        cp -rt "$DESTDIR/etc" /etc/reader.conf.d
    fi
    cp -t "$DESTDIR/etc" /etc/libccid_Info.plist 2>/dev/null || true

    for so in $(ldconfig -p | sed -nr 's/^\s*(libusb-[0-9.-]+|libpcsclite(_real)?)\s*\.so\.[0-9]+\s.*=>\s*//p'); do
        [ -f "$so" ] && copy_exec "$so"
    done

    for real in "$DESTDIR"/usr/lib/*/libpcsclite_real.so.1; do
        [ -f "$real" ] || continue
        _dir="$(dirname "$real")"
        for wrapper in "$_dir"/libpcsclite.so.1*; do
            [ -f "$wrapper" ] || continue
            cp -fL "$real" "$wrapper"
        done
    done
fi

exit $RV