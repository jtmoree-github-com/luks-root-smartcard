#!/bin/sh

# Common initramfs assets needed by all smartcard workflows.
# Debian's stock cryptroot local-bottom cleanup uses realpath() when removing
# mapped devices, so we must bundle it even on fallback boot paths.

set -e

PREREQ="cryptroot"

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Source shared libraries - try multiple paths for build-time flexibility
_source_lib() {
    if [ -f "/usr/share/luks-root-smartcard/$1" ]; then
        . "/usr/share/luks-root-smartcard/$1"
    elif [ -f "scripts/$1" ]; then
        . "scripts/$1"
    else
        echo "ERROR: Cannot find $1" >&2
        return 1
    fi
}

_source_lib "smartcard-common-lib.sh"

copy_exec "$(_find_binary_path /usr/bin/realpath /bin/realpath /usr/local/bin/realpath)" || true

