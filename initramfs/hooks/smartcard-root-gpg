#!/bin/sh

# GPG workflow hook for luks-root-smartcard.
# Copies assets needed by the GPG decrypt path only.

set -e

PREREQ="cryptroot"

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Asset inclusion mode, evaluated at initramfs generation time.
#   all      - include this workflow's assets unconditionally (default)
#   detected - include only when a matching token is in the root LUKS2 header
# Override persistently via /etc/luks-root-smartcard/initramfs.conf, or per-run
# via the SMARTCARD_INITRAMFS_INCLUDE environment variable.
SMARTCARD_INITRAMFS_INCLUDE="${SMARTCARD_INITRAMFS_INCLUDE:-all}"
[ -r /etc/luks-root-smartcard/initramfs.conf ] && . /etc/luks-root-smartcard/initramfs.conf

# Public-key source for gpg-token workflow imports:
#   SMARTCARD_GPG_SOURCE_HOME=/path/to/.gnupg   (preferred explicit override)
#   SMARTCARD_GPG_SOURCE_USER=<username>        (resolved to /home/.../.gnupg)
# Default is the invoking sudo user when available.
SMARTCARD_GPG_SOURCE_HOME="${SMARTCARD_GPG_SOURCE_HOME:-}"
SMARTCARD_GPG_SOURCE_USER="${SMARTCARD_GPG_SOURCE_USER:-${SUDO_USER:-}}"

# Token-driven activation: for each crypttab entry, resolve the backing device
# and scan its LUKS2 header for a gpg-token token. If found, include assets.
# If a device cannot be resolved at build time, include assets conservatively.

_resolve_dev_hook() {
    case "$1" in
        UUID=*)      blkid -U "${1#UUID=}" 2>/dev/null ;;
        LABEL=*)     blkid -L "${1#LABEL=}" 2>/dev/null ;;
        PARTUUID=*)  echo "/dev/disk/by-partuuid/${1#PARTUUID=}" ;;
        PARTLABEL=*) echo "/dev/disk/by-partlabel/${1#PARTLABEL=}" ;;
        *)           echo "$1" ;;
    esac
}

_has_root_gpg_token() {
    _hdev="$1"
    _hi=0
    while [ "$_hi" -lt 32 ]; do
        _hjson="$(cryptsetup token export --token-id "$_hi" "$_hdev" 2>/dev/null || true)"
        if [ -n "$_hjson" ] && printf '%s' "$_hjson" | grep -q '"type":"gpg-token"'; then
            return 0
        fi
        _hi=$(( _hi + 1 ))
    done
    return 1
}

_resolve_gpg_source_homedir() {
    if [ -n "$SMARTCARD_GPG_SOURCE_HOME" ]; then
        printf '%s\n' "$SMARTCARD_GPG_SOURCE_HOME"
        return 0
    fi
    if [ -n "$SMARTCARD_GPG_SOURCE_USER" ]; then
        _src_home="$(getent passwd "$SMARTCARD_GPG_SOURCE_USER" 2>/dev/null | cut -d: -f6)"
        if [ -n "$_src_home" ]; then
            printf '%s\n' "$_src_home/.gnupg"
            return 0
        fi
    fi
    if [ -n "${HOME:-}" ]; then
        printf '%s\n' "$HOME/.gnupg"
        return 0
    fi
    return 1
}

_import_user_keyring_pubkeys_into_initramfs() {
    _dest_home="$1"
    _source_home="$(_resolve_gpg_source_homedir || true)"
    if [ -z "$_source_home" ] || [ ! -d "$_source_home" ]; then
        echo "WARNING: no usable GPG source keyring found for gpg-token import (SMARTCARD_GPG_SOURCE_HOME/SMARTCARD_GPG_SOURCE_USER)" >&2
        return 1
    fi

    _tmp_export="$(mktemp /tmp/smartcard-gpg-export.XXXXXX)"
    if ! /usr/bin/gpg --no-options --batch --no-tty --homedir "$_source_home" --export >"$_tmp_export" 2>/dev/null; then
        rm -f "$_tmp_export"
        echo "WARNING: failed exporting public keys from source keyring: $_source_home" >&2
        return 1
    fi
    if [ ! -s "$_tmp_export" ]; then
        rm -f "$_tmp_export"
        echo "WARNING: source keyring has no exportable public keys: $_source_home" >&2
        return 1
    fi

    if ! /usr/bin/gpg --no-options --no-autostart --trust-model=always \
        --quiet --batch --no-tty --logger-file=/dev/null \
        --homedir="$_dest_home" --import <"$_tmp_export"; then
        rm -f "$_tmp_export"
        echo "WARNING: failed importing source keyring pubkeys into initramfs GNUPGHOME" >&2
        return 1
    fi

    rm -f "$_tmp_export"
    return 0
}

_using_gpg_token=false
_crypttab="${TABFILE:-/etc/crypttab}"
if [ -f "$_crypttab" ]; then
    while IFS= read -r _ctline; do
        case "$_ctline" in ''|'#'*) continue ;; esac
        set -- $_ctline
        [ "$#" -ge 2 ] || continue
        _hdev="$(_resolve_dev_hook "$2" 2>/dev/null || true)"
        if [ -b "$_hdev" ]; then
            if _has_root_gpg_token "$_hdev"; then
                _using_gpg_token=true
                break
            fi
        else
            _using_gpg_token=true
            break
        fi
    done < "$_crypttab"
fi
if [ "${SMARTCARD_INITRAMFS_INCLUDE:-all}" = "detected" ] && [ "$_using_gpg_token" = false ]; then
    exit 0
fi

RV=0

if [ -x /usr/bin/base64 ]; then
    copy_exec /usr/bin/base64
fi
if [ -x /usr/bin/openssl ]; then
    copy_exec /usr/bin/openssl
fi

# Copy key files referenced in crypttab.
if [ -f /lib/cryptsetup/functions ]; then
    . /lib/cryptsetup/functions
    copy_keys() {
        crypttab_parse_options
        _key_prefix="${CRYPTTAB_KEY%%:*}"
        case "$CRYPTTAB_KEY" in
            none)
                ;;
            *)
                case "$_key_prefix" in
                    systemd-pkcs11)
                        ;;
                    *)
                        if [ -f "$CRYPTTAB_KEY" ]; then
                            [ -f "$DESTDIR$CRYPTTAB_KEY" ] || copy_file keyfile "$CRYPTTAB_KEY" || RV=$?
                        fi
                        ;;
                esac
                ;;
        esac
    }
    [ -f "${TABFILE:-}" ] && crypttab_foreach_entry copy_keys
fi

# pcscd + reader drivers: on Debian/Ubuntu scdaemon talks to the card
# via pcscd (not a built-in CCID driver).  This also provides pcscd for
# stock decrypt_gnupg-sc when our script exits without handling the entry.
if [ -x /usr/sbin/pcscd ]; then
    copy_exec /usr/sbin/pcscd

    mkdir -p -- "$DESTDIR/usr/lib/pcsc"
    cp -rt "$DESTDIR/usr/lib" /usr/lib/pcsc

    cp -t "$DESTDIR/etc" /etc/reader.conf 2>/dev/null || true
    if [ -d /etc/reader.conf.d ]; then
        cp -rt "$DESTDIR/etc" /etc/reader.conf.d
    fi
    cp -t "$DESTDIR/etc" /etc/libccid_Info.plist 2>/dev/null || true

    for so in $(ldconfig -p | sed -nr 's/^\s*(libusb-[0-9.-]+|libpcsclite(_real)?)\s*\.so\.[0-9]+\s.*=>\s*//p'); do
        [ -f "$so" ] && copy_exec "$so"
    done

    for real in "$DESTDIR"/usr/lib/*/libpcsclite_real.so.1; do
        [ -f "$real" ] || continue
        _dir="$(dirname "$real")"
        for wrapper in "$_dir"/libpcsclite.so.1*; do
            [ -f "$wrapper" ] || continue
            cp -fL "$real" "$wrapper"
        done
    done
fi

for _gpgbin in /usr/bin/gpg /usr/bin/gpg-agent /usr/lib/gnupg/scdaemon /usr/bin/gpgconf /usr/bin/gpg-connect-agent; do
    if [ -x "$_gpgbin" ]; then
        copy_exec "$_gpgbin"
    else
        echo "WARNING: $_gpgbin not found; GPG smartcard unlock unavailable" >&2
        if [ "$_using_gpg_token" = true ]; then RV=1; fi
    fi
done

[ -d "$DESTDIR/cryptroot/gnupghome" ] || mkdir -pm0700 "$DESTDIR/cryptroot/gnupghome"

if [ "$_using_gpg_token" = true ]; then
    if ! _import_user_keyring_pubkeys_into_initramfs "$DESTDIR/cryptroot/gnupghome"; then
        RV=1
    fi
fi
find "$DESTDIR/cryptroot" -name "*~" -type f -delete

pinentry=""
if [ -x "/usr/bin/pinentry-curses" ]; then
    pinentry="/usr/bin/pinentry-curses"
elif [ -x "/usr/bin/pinentry-tty" ]; then
    pinentry="/usr/bin/pinentry-tty"
elif [ -x "$DESTDIR/usr/bin/pinentry" ]; then
    : # Use existing pinentry from another hook
else
    echo "WARNING: missing pinentry-curses or pinentry-tty" >&2
    if [ "$_using_gpg_token" = true ]; then RV=1; fi
fi
if [ -n "${pinentry:-}" ]; then
    copy_exec "$pinentry"
    rm -f "$DESTDIR/usr/bin/pinentry"
    ln -s "$(basename "$pinentry")" "$DESTDIR/usr/bin/pinentry"
fi

for d in "/usr/share/terminfo" "/lib/terminfo"; do
    if [ -f "$d/l/linux" ]; then
        [ -f "$DESTDIR$d/l/linux" ] || copy_file terminfo "$d/l/linux" || RV=$?
        break
    fi
done

exit $RV