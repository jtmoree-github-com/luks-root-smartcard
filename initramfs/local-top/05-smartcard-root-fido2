#!/bin/sh
set -eu

PREREQ=""

prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/functions

DEBUG_ENABLED=0
for _dbg_tok in $(cat /proc/cmdline 2>/dev/null); do
  case "$_dbg_tok" in
    rd.debug|rd.debug=1|rd.debug=true|smartcard-root.debug|smartcard-root.debug=1|smartcard-root.debug=true)
      DEBUG_ENABLED=1
      ;;
    rd.debug=0|rd.debug=false|smartcard-root.debug=0|smartcard-root.debug=false)
      DEBUG_ENABLED=0
      ;;
  esac
done

log_kmsg() {
  [ -w /dev/kmsg ] || return 0
  printf '<6>smartcard-root-fido2: %s\n' "$*" >/dev/kmsg 2>/dev/null || true
}
msg() {
  echo "smartcard-root-fido2: $*" >&2
  log_kmsg "$*"
}
dbg() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  echo "smartcard-root-fido2: DEBUG: $*" >&2
  log_kmsg "DEBUG: $*"
}
dbg_log_file_lines() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  _prefix="$1"
  _file="$2"
  [ -r "$_file" ] || return 0
  while IFS= read -r _line || [ -n "$_line" ]; do
    dbg "${_prefix}${_line}"
  done <"$_file"
}
DEBUG_SUMMARY_RESULT="fallback"
DEBUG_SUMMARY_REASON="unclassified"
set_debug_summary() {
  DEBUG_SUMMARY_RESULT="$1"
  DEBUG_SUMMARY_REASON="$2"
}
emit_debug_summary() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  dbg "summary result=$DEBUG_SUMMARY_RESULT reason=$DEBUG_SUMMARY_REASON mapper=${CRYPTROOT_NAME:-unset} device=${DEV:-unset}"
}
trap emit_debug_summary EXIT
dbg "debug logging enabled"

prepare_prompt_console() {
  # Plymouth can hold the graphical framebuffer active even after hide-splash;
  # quit it and switch to a text console so prompts show without pressing Escape.
  if command -v plymouth >/dev/null 2>&1; then
    plymouth --hide-splash >/dev/null 2>&1 || true
    plymouth --quit >/dev/null 2>&1 || true
  fi
  if command -v chvt >/dev/null 2>&1; then
    chvt 1 >/dev/null 2>&1 || true
  fi
  if [ -c /dev/tty1 ]; then
    exec </dev/tty1 >/dev/tty1 2>/dev/tty1
  elif [ -c /dev/console ]; then
    exec </dev/console >/dev/console 2>/dev/console
  fi
  export TERM=linux
}

announce_fido2_pin_prompt() {
  _pin_notice="FIDO2 unlock: enter token PIN now (then touch token if requested)"
  dbg "$_pin_notice"
  if [ -w /dev/tty1 ]; then
    printf '\n%s\n' "$_pin_notice" >/dev/tty1 2>/dev/null || true
  elif [ -w /dev/console ]; then
    printf '\n%s\n' "$_pin_notice" >/dev/console 2>/dev/null || true
  else
    msg "$_pin_notice"
  fi
}

get_root_mapper_name() {
  for tok in $(cat /proc/cmdline); do
    case "$tok" in root=/dev/mapper/*) echo "${tok#root=/dev/mapper/}"; return 0 ;; esac
  done
  echo ""
}

resolve_mapping() {
  preferred_target="$1"
  found_target=""
  found_source=""
  found_key=""

  [ -r /cryptroot/crypttab ] || panic "smartcard-root-fido2: /cryptroot/crypttab missing"

  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    set -- $line
    [ "$#" -ge 3 ] || continue
    if [ -n "$preferred_target" ]; then
      [ "$1" = "$preferred_target" ] || continue
    fi
    if [ -z "$found_target" ]; then
      found_target="$1"; found_source="$2"; found_key="$3"
      [ -n "$preferred_target" ] && break
    fi
  done </cryptroot/crypttab

  [ -n "$found_target" ] || panic "smartcard-root-fido2: no usable mapping found in /cryptroot/crypttab"
  printf '%s|%s|%s\n' "$found_target" "$found_source" "$found_key"
}

resolve_device() {
  case "$1" in
    UUID=*)     blkid -U "${1#UUID=}" 2>/dev/null ;;
    LABEL=*)    blkid -L "${1#LABEL=}" 2>/dev/null ;;
    PARTUUID=*) echo "/dev/disk/by-partuuid/${1#PARTUUID=}" ;;
    PARTLABEL=*) echo "/dev/disk/by-partlabel/${1#PARTLABEL=}" ;;
    *)          echo "$1" ;;
  esac
}

auto_detect_fido2_token() {
  _dev="$1"
  _i=0
  while [ "$_i" -lt 32 ]; do
    _json="$(cryptsetup token export --token-id "$_i" "$_dev" 2>/dev/null || true)"
    if [ -n "$_json" ]; then
      _type="$(printf '%s' "$_json" | tr -d '\n' | sed -n 's/.*"type":"\([^"]*\)".*/\1/p')"
      dbg "token $_i type=${_type:-unknown}"
      if [ "$_type" = "systemd-fido2" ]; then
        echo "$_i"
        return 0
      fi
    fi
    _i=$(( _i + 1 ))
  done
  return 1
}

find_fido2_plugin_dir() {
  for _dir in /usr/lib/*/cryptsetup /usr/lib64/cryptsetup; do
    [ -f "$_dir/libcryptsetup-token-systemd-fido2.so" ] || continue
    dbg "found FIDO2 plugin dir: $_dir"
    echo "$_dir"
    return 0
  done
  dbg "no FIDO2 plugin dir found in initramfs search paths"
  return 1
}

# Detect an actual FIDO2 authenticator by scanning HID report descriptors for
# the FIDO alliance usage page (0xF1D0 -> bytes 06 d0 f1); a bare hidraw node
# is not enough since other HID devices also expose hidraw.
_fido2_device_present() {
  # Preferred: libfido2 enumeration gives accurate presence/absence.
  if command -v fido2-token >/dev/null 2>&1; then
    if [ -n "$(fido2-token -L 2>/dev/null || true)" ]; then
      dbg "FIDO2 authenticator detected via fido2-token -L"
      return 0
    fi
    dbg "fido2-token -L found no authenticator"
    return 1
  fi
  # Without fido2-token, fall back to the HID report descriptor, which
  # advertises the FIDO usage page (0xF1D0 -> bytes 06 d0 f1); this
  # distinguishes a FIDO2 key from other HID devices.
  _fido_pat="$(printf '\006\320\361')"
  for _rd in /sys/class/hidraw/hidraw*/device/report_descriptor; do
    [ -r "$_rd" ] || continue
    if grep -qF "$_fido_pat" "$_rd" 2>/dev/null; then
      dbg "FIDO2 authenticator detected via HID usage page ($_rd)"
      return 0
    fi
  done
  dbg "no FIDO2 HID report descriptor matched usage page 0xF1D0"
  return 1
}

wait_for_fido2_device() {
  _try=0
  while [ "$_try" -lt 5 ]; do
    if _fido2_device_present; then
      return 0
    fi
    _try=$(( _try + 1 ))
    dbg "waiting for FIDO2 authenticator ($_try/5)"
    sleep 1
  done
  return 1
}

prompt_skip_or_wait_fido2() {
  if [ -f /run/smartcard-skip-requested-fido2 ]; then
    dbg "skip marker already present for FIDO2 workflow"
    return 0
  fi

  prepare_prompt_console
  echo "FIDO2 security key not detected. Skip and continue with fallback? [Y/n]" > /dev/console
  read ANSWER
  dbg "user response for FIDO2 skip prompt: ${ANSWER:-<empty>}"
  case "${ANSWER:-Y}" in
    y|Y|"")
      : >/run/smartcard-skip-requested-fido2
      return 0
      ;;
    *)
      msg "Waiting for FIDO2 authenticator..."
      while true; do
        if wait_for_fido2_device; then
          break
        fi
        sleep 1
      done
      return 1
      ;;
  esac
}

prompt_retry_fido2_unlock() {
  prepare_prompt_console
  echo "Retry unlock now? [y/N]" > /dev/console
  read ANSWER
  dbg "user response for FIDO2 retry prompt: ${ANSWER:-<empty>}"
  case "${ANSWER:-N}" in
    y|Y) return 0 ;;
    *)   return 1 ;;
  esac
}

mapping="$(resolve_mapping "$(get_root_mapper_name)")"
CRYPTROOT_NAME="${mapping%%|*}"
rest="${mapping#*|}"
CRYPTROOT_SOURCE="${rest%%|*}"
KEY_SPEC="${rest#*|}"

dbg "mapping name=$CRYPTROOT_NAME source=$CRYPTROOT_SOURCE key-spec=${KEY_SPEC:-<empty>}"

if cryptsetup status "$CRYPTROOT_NAME" >/dev/null 2>&1; then
  dbg "mapping $CRYPTROOT_NAME already active"
  set_debug_summary "skip" "mapping-already-active"
  exit 0
fi

DEV="$(resolve_device "$CRYPTROOT_SOURCE")" || panic "smartcard-root-fido2: cannot resolve device $CRYPTROOT_SOURCE"
[ -b "$DEV" ] || panic "smartcard-root-fido2: $DEV is not a block device"
dbg "resolved backing device: $DEV"

TOKEN_ID="$(auto_detect_fido2_token "$DEV" || true)"
if [ -z "$TOKEN_ID" ]; then
  dbg "no systemd-fido2 token found on root device; exiting FIDO2 path"
  set_debug_summary "skip" "no-systemd-fido2-token"
  exit 0
fi
msg "auto-detected token selector: systemd-fido2:$TOKEN_ID"

PLUGIN_DIR="$(find_fido2_plugin_dir || true)"
if [ -z "$PLUGIN_DIR" ]; then
  msg "FIDO2 token plugin not present in initramfs; continuing to next workflow"
  set_debug_summary "fallback" "missing-fido2-plugin"
  exit 0
fi
dbg "using FIDO2 plugin dir: $PLUGIN_DIR"

if ! wait_for_fido2_device; then
  if prompt_skip_or_wait_fido2; then
    msg "skipping FIDO2 workflow; continuing to next workflow"
    set_debug_summary "fallback" "user-skipped-no-fido2-device"
    exit 0
  fi
fi

# Dismiss the boot splash before the plugin's PIN prompt on the happy path too.
prepare_prompt_console
while true; do
  announce_fido2_pin_prompt
  _fido2_open_log="$(mktemp /run/smartcard-fido2-open.XXXXXX)"
  if cryptsetup luksOpen \
      --token-only \
      --token-type systemd-fido2 \
      --token-id "$TOKEN_ID" \
      --external-tokens-path "$PLUGIN_DIR" \
      "$DEV" "$CRYPTROOT_NAME" 2>"$_fido2_open_log"; then
    dbg "cryptsetup luksOpen succeeded via FIDO2 token"
    set_debug_summary "success" "fido2-unlock"
    rm -f "$_fido2_open_log"
    exit 0
  fi
  dbg "cryptsetup luksOpen failed via FIDO2 token"
  dbg_log_file_lines "cryptsetup: " "$_fido2_open_log"
  rm -f "$_fido2_open_log"

  msg "FIDO2 unlock failed"
  if prompt_skip_or_wait_fido2; then
    msg "bypassing FIDO2 workflow; continuing to next workflow"
    set_debug_summary "fallback" "user-skipped-after-fido2-failure"
    exit 0
  fi
  if prompt_retry_fido2_unlock; then
    msg "user requested retry of FIDO2 unlock"
    continue
  fi
  msg "not retrying FIDO2 unlock; continuing to next workflow"
  set_debug_summary "fallback" "user-declined-fido2-retry"
  exit 0
done