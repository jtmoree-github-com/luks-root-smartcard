#!/bin/sh
set -eu

PREREQ=""

prereqs() {
  echo "$PREREQ"
}

case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/functions

DEBUG_ENABLED=0
for _dbg_tok in $(cat /proc/cmdline 2>/dev/null); do
  case "$_dbg_tok" in
    rd.debug|rd.debug=1|rd.debug=true|smartcard-root.debug|smartcard-root.debug=1|smartcard-root.debug=true)
      DEBUG_ENABLED=1
      ;;
    rd.debug=0|rd.debug=false|smartcard-root.debug=0|smartcard-root.debug=false)
      DEBUG_ENABLED=0
      ;;
  esac
done

log_kmsg() {
  [ -w /dev/kmsg ] || return 0
  printf '<6>smartcard-root-gpg: %s\n' "$*" >/dev/kmsg 2>/dev/null || true
}
msg() {
  echo "smartcard-root-gpg: $*" >&2
  log_kmsg "$*"
}
dbg() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  echo "smartcard-root-gpg: DEBUG: $*" >&2
  log_kmsg "DEBUG: $*"
}
dbg_now() {
  date '+%s' 2>/dev/null || echo "?"
}
dbg_log_file_lines() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  _prefix="$1"
  _file="$2"
  [ -r "$_file" ] || return 0
  while IFS= read -r _line || [ -n "$_line" ]; do
    dbg "${_prefix}${_line}"
  done <"$_file"
}
dbg_gpg_runtime_state() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  _label="$1"
  dbg "${_label}: GNUPGHOME=${GNUPGHOME:-unset}"
  if [ -n "${GNUPGHOME:-}" ] && [ -d "$GNUPGHOME" ]; then
    ls -ld "$GNUPGHOME" 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: gnupg-home: /' >&2 || true
    ls -la "$GNUPGHOME" 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: gnupg-home: /' >&2 || true
  else
    dbg "${_label}: GNUPGHOME directory missing"
  fi
  if command -v gpgconf >/dev/null 2>&1; then
    gpgconf --list-dirs 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: gpgconf: /' >&2 || true
  fi
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -a gpg-agent 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: gpg-agent: /' >&2 || true
    pgrep -a scdaemon 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: scdaemon: /' >&2 || true
  fi
  if command -v ps >/dev/null 2>&1; then
    ps -o pid,ppid,comm,args -C gpg-agent -C scdaemon 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: ps: /' >&2 || true
  fi
  for _sock in \
    /run/pcscd/pcscd.comm \
    /var/run/pcscd/pcscd.comm \
    /run/gpg-agent* \
    /run/scdaemon* \
    ${GNUPGHOME:-}/S.gpg-agent \
    ${GNUPGHOME:-}/S.scdaemon \
    ${GNUPGHOME:-}/private-keys-v1.d \
  ; do
    if [ -e "$_sock" ]; then
      ls -ld "$_sock" 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: socket: /' >&2 || true
    fi
  done
  if command -v gpg-connect-agent >/dev/null 2>&1 && [ -n "${GNUPGHOME:-}" ]; then
    if gpg-connect-agent --homedir "$GNUPGHOME" --quiet 'GETINFO socket_name' /bye 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: gpg-agent-socket: /' >&2; then
      :
    else
      dbg "${_label}: gpg-connect-agent GETINFO socket_name failed"
    fi
  fi
}
GPG_CARD_PROBE_COUNT=0
PCSCD_START_COUNT=0
DEBUG_SUMMARY_RESULT="fallback"
DEBUG_SUMMARY_REASON="unclassified"
set_debug_summary() {
  DEBUG_SUMMARY_RESULT="$1"
  DEBUG_SUMMARY_REASON="$2"
}
emit_debug_summary() {
  [ "$DEBUG_ENABLED" = "1" ] || return 0
  dbg "summary result=$DEBUG_SUMMARY_RESULT reason=$DEBUG_SUMMARY_REASON mapper=${CRYPTROOT_NAME:-unset} device=${DEV:-unset}"
}
trap emit_debug_summary EXIT
dbg "debug logging enabled"

prepare_prompt_console() {
  # Avoid interacting with plymouth here. On some systems, even hide-splash can
  # trigger a display mode handoff right before the smartcard prompt.
  if [ -c /dev/console ]; then
    exec </dev/console >/dev/console 2>/dev/console
  elif [ -c /dev/tty1 ]; then
    exec </dev/tty1 >/dev/tty1 2>/dev/tty1
  fi
  export TERM=linux
}

# This script is token-driven: it scans the root LUKS2 header for gpg-token
# tokens and only activates smartcard handling when such a token is present.
# If no gpg-token token exists, it exits without prompting.

# Set GNUPGHOME so all gpg calls (card-status, decrypt, etc.) use it.
# gpg --card-status needs a writable homedir for agent sockets and keybox
# state even before any pubring has been imported into initramfs.
export GNUPGHOME="/cryptroot/gnupghome"
if [ ! -d "$GNUPGHOME" ]; then
  mkdir -pm0700 "$GNUPGHOME" || panic "smartcard-root-gpg: cannot create $GNUPGHOME"
fi

get_root_mapper_name() {
  for tok in $(cat /proc/cmdline); do
    case "$tok" in root=/dev/mapper/*) echo "${tok#root=/dev/mapper/}"; return 0 ;; esac
  done
  echo ""
}

resolve_mapping() {
  preferred_target="$1"
  found_target=""
  found_source=""
  found_key=""

  [ -r /cryptroot/crypttab ] || panic "smartcard-root-gpg: /cryptroot/crypttab missing"

  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    set -- $line
    [ "$#" -ge 3 ] || continue
    if [ -n "$preferred_target" ]; then
      [ "$1" = "$preferred_target" ] || continue
    fi
    if [ -z "$found_target" ]; then
      found_target="$1"; found_source="$2"; found_key="$3"
      [ -n "$preferred_target" ] && break
    fi
  done </cryptroot/crypttab

  [ -n "$found_target" ] || panic "smartcard-root-gpg: no usable mapping found in /cryptroot/crypttab"
  printf '%s|%s|%s\n' "$found_target" "$found_source" "$found_key"
}

resolve_device() {
  case "$1" in
    UUID=*)     blkid -U "${1#UUID=}" 2>/dev/null ;;
    LABEL=*)    blkid -L "${1#LABEL=}" 2>/dev/null ;;
    PARTUUID=*) echo "/dev/disk/by-partuuid/${1#PARTUUID=}" ;;
    PARTLABEL=*) echo "/dev/disk/by-partlabel/${1#PARTLABEL=}" ;;
    *)          echo "$1" ;;
  esac
}

json_value() {
  _jv_json="$1"
  _jv_key="$2"
  _jv_flat="$(printf '%s' "$_jv_json" | tr -d '\n')"
  _jv_after="${_jv_flat#*\"${_jv_key}\":\"}"
  [ "$_jv_after" != "$_jv_flat" ] || return 1
  _jv_val="${_jv_after%%\"*}"
  printf '%s' "$_jv_val"
}

extract_token_blob() {
  _dev="$1"
  _selector="$2"
  _token_id="${_selector#*:}"
  _b64=""

  if [ "$_token_id" = "auto" ]; then
    _i=0
    while [ "$_i" -lt 32 ]; do
      _json="$(cryptsetup token export --token-id "$_i" "$_dev" 2>/dev/null || true)"
      if [ -n "$_json" ]; then
        _t="$(json_value "$_json" "type" || true)"
        if [ "$_t" = "gpg-token" ]; then
          _b64="$(json_value "$_json" "gpg-key" || true)"
          [ -n "$_b64" ] && break
        fi
      fi
      _i=$(( _i + 1 ))
    done
  else
    _json="$(cryptsetup token export --token-id "$_token_id" "$_dev" 2>/dev/null || true)"
    if [ -n "$_json" ]; then
      _t="$(json_value "$_json" "type" || true)"
      if [ "$_t" = "gpg-token" ]; then
        _b64="$(json_value "$_json" "gpg-key" || true)"
      fi
    fi
  fi

  [ -n "$_b64" ] || return 1

  _tmp="$(mktemp /run/smartcard-blob.XXXXXX)"
  if ! printf '%s\n' "$_b64" | base64 -d >"$_tmp" 2>/dev/null; then
    _b64f="$(mktemp /run/smartcard-b64.XXXXXX)"
    printf '%s\n' "$_b64" >"$_b64f"
    if ! base64 -d <"$_b64f" >"$_tmp" 2>/dev/null; then
      if ! openssl base64 -d -in "$_b64f" -out "$_tmp" 2>/dev/null; then
        rm -f "$_tmp" "$_b64f"
        return 1
      fi
    fi
    rm -f "$_b64f"
  fi
  chmod 600 "$_tmp"
  echo "$_tmp"
}

decrypt_gpg() {
  prepare_prompt_console

  if ! GPG_TTY="$(tty 2>/dev/null)"; then
    read _console _rest </proc/consoles
    GPG_TTY="/dev/$_console"
  fi
  export GPG_TTY
  dbg "decrypt_gpg using GPG_TTY=$GPG_TTY"

  # Keep the normal GnuPG agent + pinentry flow alive.  The stock
  # initramfs decrypt_gnupg-sc script does not kill scdaemon/gpg-agent
  # before the PIN prompt; doing so breaks smartcard auth.
  _gpg_dec_log="$(mktemp /run/smartcard-gpg-decrypt.XXXXXX)"
  if gpg --no-options --trust-model=always --decrypt -- "$1" >"$2" 2>"$_gpg_dec_log"; then
    rm -f "$_gpg_dec_log"
    return 0
  fi
  dbg "gpg --decrypt failed"
  dbg_log_file_lines "gpg-decrypt: " "$_gpg_dec_log"
  rm -f "$_gpg_dec_log"
  return 1
}

check_smartcard() {
  GPG_CARD_PROBE_COUNT=$(( GPG_CARD_PROBE_COUNT + 1 ))
  dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT} ts=$(dbg_now)"
  dbg_gpg_runtime_state "before-card-probe"

  if command -v gpgconf >/dev/null 2>&1; then
    gpgconf --kill scdaemon 2>/dev/null || true
    gpgconf --kill gpg-agent 2>/dev/null || true
    dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT}: killed scdaemon/gpg-agent before probe"
  fi

  if pidof pcscd >/dev/null 2>&1; then
    _pcscd_pids="$(pidof pcscd 2>/dev/null || true)"
    dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT}: pcscd active pids=${_pcscd_pids:-none}; clearing stale instance"
    for _pcscd_pid in $_pcscd_pids; do
      kill -TERM "$_pcscd_pid" 2>/dev/null || true
    done
    sleep 1
    rm -f /run/pcscd.pid /run/pcscd/pcscd.comm
  fi

  if command -v gpg >/dev/null 2>&1; then
    _card_status_log="$(mktemp /run/gpg-card-status.XXXXXX)"
    dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT}: running gpg --card-status"
    dbg_gpg_runtime_state "before-gpg-card-status"
    dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT}: env GPG_TTY=${GPG_TTY:-unset} GNUPGHOME=${GNUPGHOME:-unset}"
    if command -v gpgconf >/dev/null 2>&1; then
      gpgconf --list-options gpg-agent 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: gpg-agent-options: /' >&2 || true
      gpgconf --list-options scdaemon 2>/dev/null | sed 's/^/smartcard-root-gpg: DEBUG: scdaemon-options: /' >&2 || true
    fi
    if command -v pcscd >/dev/null 2>&1; then
      pcscd --version 2>&1 | sed 's/^/smartcard-root-gpg: DEBUG: pcscd-version: /' >&2 || true
    fi
    if command -v gpg >/dev/null 2>&1; then
      gpg --version 2>&1 | sed 's/^/smartcard-root-gpg: DEBUG: gpg-version: /' >&2 || true
    fi
    if gpg --no-options --trust-model=always --batch --no-tty --card-status >"$_card_status_log" 2>&1; then
      dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT}: gpg --card-status succeeded"
      dbg_gpg_runtime_state "after-gpg-card-status-success"
      dbg_log_file_lines "card-status: " "$_card_status_log"
      rm -f "$_card_status_log"
      return 0
    fi
    dbg "card-probe attempt=${GPG_CARD_PROBE_COUNT}: gpg --card-status failed"
    dbg_gpg_runtime_state "after-gpg-card-status-failure"
    dbg_log_file_lines "card-status: " "$_card_status_log"
    if [ "$DEBUG_ENABLED" = "1" ] && command -v gpgscm >/dev/null 2>&1; then
      gpgscm --version 2>&1 | sed 's/^/smartcard-root-gpg: DEBUG: gpgscm: /' >&2 || true
    fi
    rm -f "$_card_status_log"
  else
    dbg "gpg command not present in initramfs environment"
  fi
  return 1
}

prompt_skip_or_wait() {
  if [ -f /run/smartcard-skip-requested-gpg ]; then
    dbg "skip marker already present for GPG workflow"
    return 0
  fi

  prepare_prompt_console
  echo "GPG smartcard not detected. Skip and continue with fallback? [Y/n]" > /dev/console
  read ANSWER
  dbg "user response for GPG skip prompt: ${ANSWER:-<empty>}"
  case "${ANSWER:-Y}" in
    y|Y|"")
      : >/run/smartcard-skip-requested-gpg
      return 0
      ;;
    *)
      msg "Please insert SmartCard..."
      _wait_try=0
      while true; do
        _wait_try=$(( _wait_try + 1 ))
        dbg "wait loop attempt=${_wait_try} ts=$(dbg_now): probing for SmartCard (scdaemon built-in CCID)"
        # Stop pcscd so scdaemon uses its built-in CCID driver directly.
        # This is the same path as the initial detection attempt 1, which
        # succeeds when the card is present. pcscd in initramfs cannot detect
        # hot-plugged cards reliably; scdaemon's CCID driver can.
        if pidof pcscd >/dev/null 2>&1; then
          for _pcscd_pid in $(pidof pcscd 2>/dev/null); do
            kill "$_pcscd_pid" 2>/dev/null || true
          done
        fi
        rm -f /run/pcscd.pid /run/pcscd/pcscd.comm
        if check_smartcard; then
          break
        fi
        sleep 5
      done
      return 1
      ;;
  esac
}

auto_detect_gpg_token() {
  _dev="$1"
  _i=0
  while [ "$_i" -lt 32 ]; do
    _json="$(cryptsetup token export --token-id "$_i" "$_dev" 2>/dev/null || true)"
    if [ -n "$_json" ]; then
      _t="$(json_value "$_json" "type" || true)"
      dbg "token $_i type=${_t:-unknown}"
      if [ "$_t" = "gpg-token" ]; then
        echo "gpg-token:$_i"
        return 0
      fi
    fi
    _i=$(( _i + 1 ))
  done
  return 1
}

mapping="$(resolve_mapping "$(get_root_mapper_name)")"
CRYPTROOT_NAME="${mapping%%|*}"
rest="${mapping#*|}"
CRYPTROOT_SOURCE="${rest%%|*}"
KEY_SPEC="${rest#*|}"

dbg "mapping name=$CRYPTROOT_NAME source=$CRYPTROOT_SOURCE key-spec=${KEY_SPEC:-<empty>}"

if cryptsetup status "$CRYPTROOT_NAME" >/dev/null 2>&1; then
  dbg "mapping $CRYPTROOT_NAME already active"
  set_debug_summary "skip" "mapping-already-active"
  exit 0
fi

DEV="$(resolve_device "$CRYPTROOT_SOURCE")" || panic "smartcard-root-gpg: cannot resolve device $CRYPTROOT_SOURCE"
[ -b "$DEV" ] || panic "smartcard-root-gpg: $DEV is not a block device"
dbg "resolved backing device: $DEV"

# Always detect from the LUKS2 header so custom handling runs whenever a
# gpg-token token exists on the root device.
KEY_SPEC="$(auto_detect_gpg_token "$DEV" || true)"
if [ -z "$KEY_SPEC" ]; then
  dbg "no gpg-token token found on root device; exiting GPG token path"
  set_debug_summary "skip" "no-gpg-token"
  exit 0
fi
msg "auto-detected token selector: $KEY_SPEC"
SMARTCARD_EXPECT="1"

dbg "GNUPGHOME=$GNUPGHOME"
dbg_gpg_runtime_state "gnupg-initial-state"
if gpg --no-options --batch --with-keygrip --list-secret-keys >/dev/null 2>&1; then
  dbg "gpg secret-key stubs are present in initramfs GNUPGHOME"
else
  dbg "gpg secret-key listing failed or no secret-key stubs yet (card-status will create them)"
fi

# Keep the live GnuPG agent intact so the PIN prompt can complete normally.
# The Debian stock decrypt_gnupg-sc path does not reset the agent before the
# pinentry prompt; it relies on tty-based pinentry instead.
start_pcscd() {
  PCSCD_START_COUNT=$(( PCSCD_START_COUNT + 1 ))
  dbg "pcscd-start attempt=${PCSCD_START_COUNT} ts=$(dbg_now)"
  command -v pcscd >/dev/null 2>&1 || return 1

  # Clean stale runtime state from a prior failed start or an initramfs retry.
  if [ -f /run/pcscd.pid ] && ! kill -0 "$(cat /run/pcscd.pid 2>/dev/null)" 2>/dev/null; then
    dbg "pcscd-start attempt=${PCSCD_START_COUNT}: removing stale /run/pcscd.pid and socket"
    rm -f /run/pcscd.pid /run/pcscd/pcscd.comm
  fi

  if pidof pcscd >/dev/null 2>&1; then
    _pcscd_pids="$(pidof pcscd 2>/dev/null || true)"
    dbg "pcscd-start attempt=${PCSCD_START_COUNT}: existing pids=${_pcscd_pids:-none}; restarting cleanly"
    for _pcscd_pid in $_pcscd_pids; do
      kill -TERM "$_pcscd_pid" 2>/dev/null || true
    done
    sleep 1
    rm -f /run/pcscd.pid /run/pcscd/pcscd.comm
  fi

  if pidof pcscd >/dev/null 2>&1; then
    dbg "pcscd-start attempt=${PCSCD_START_COUNT}: pcscd still active after shutdown; leaving it alone"
    return 0
  fi

  dbg "pcscd-start attempt=${PCSCD_START_COUNT}: launching /usr/sbin/pcscd --foreground --disable-polkit"
  dbg_gpg_runtime_state "before-pcscd-start"
  mkdir -p /run/pcscd
  rm -f /run/pcscd/pcscd.comm
  /usr/sbin/pcscd --foreground --disable-polkit 2>/run/pcscd-stderr.log &
  echo $! >/run/pcscd.pid
  dbg "pcscd-start attempt=${PCSCD_START_COUNT}: started pid=$(cat /run/pcscd.pid 2>/dev/null || echo unknown)"
  dbg_log_file_lines "pcscd: " /run/pcscd-stderr.log
  _w=0
  while [ "$_w" -lt 3 ]; do
    sleep 1; _w=$(( _w + 1 ))
    if ! kill -0 "$(cat /run/pcscd.pid)" 2>/dev/null; then
      dbg "pcscd-start attempt=${PCSCD_START_COUNT}: pcscd exited after ${_w}s; stderr:"
      if [ "$DEBUG_ENABLED" = "1" ]; then
        sed 's/^/  pcscd: /' /run/pcscd-stderr.log >&2 2>/dev/null || true
      fi
      return 1
    fi
    if [ -e /run/pcscd/pcscd.comm ]; then
      dbg "pcscd-start attempt=${PCSCD_START_COUNT}: socket ready after ${_w}s"
      return 0
    fi
    dbg "pcscd-start attempt=${PCSCD_START_COUNT}: waiting for socket (${_w}/3)"
  done
  dbg "pcscd-start attempt=${PCSCD_START_COUNT}: running pid=$(cat /run/pcscd.pid)"
  return 0
}

CARD_FOUND=false
if [ "$SMARTCARD_EXPECT" = "1" ]; then
  dbg "smartcard expectation enabled (interactive mode)"
  if check_smartcard; then
    CARD_FOUND=true
  else
    if ! pidof pcscd >/dev/null 2>&1; then
      msg "smartcard not detected via internal CCID; starting pcscd and retrying..."
      dbg "initial probe path: no running pcscd before retry branch"
      start_pcscd || true
      gpgconf --kill scdaemon 2>/dev/null || true
      dbg "initial probe path: retrying card probe after pcscd start"
      if check_smartcard; then
        CARD_FOUND=true
      fi
    fi
    if [ "$CARD_FOUND" = false ]; then
      if prompt_skip_or_wait; then
        msg "skipping GPG smartcard flow; continuing to standard cryptroot fallback"
        set_debug_summary "fallback" "user-skipped-no-gpg-card"
        exit 0
      fi
      CARD_FOUND=true
    fi
  fi
else
  dbg "smartcard expectation disabled (non-interactive mode)"
  if check_smartcard; then
    CARD_FOUND=true
  else
    if ! pidof pcscd >/dev/null 2>&1; then
      start_pcscd || true
      gpgconf --kill scdaemon 2>/dev/null || true
      if check_smartcard; then
        CARD_FOUND=true
      fi
    fi
  fi

  if [ "$CARD_FOUND" = false ]; then
    msg "smartcard not detected and expectation trigger is disabled; continuing to standard cryptroot fallback"
    set_debug_summary "fallback" "no-gpg-card-noninteractive"
    exit 0
  fi
fi

TMP_KEY="$(mktemp /run/smartcard-key.XXXXXX)"
chmod 600 "$TMP_KEY"
while true; do
  unlock_ok=false

  BLOB="$(extract_token_blob "$DEV" "$KEY_SPEC" || true)"
  if [ -z "$BLOB" ]; then
    dbg "failed to extract gpg-key blob from token selector $KEY_SPEC"
  elif decrypt_gpg "$BLOB" "$TMP_KEY"; then
    dbg "gpg token decrypt succeeded"
    _gpg_open_log="$(mktemp /run/smartcard-gpg-open.XXXXXX)"
    if cryptsetup luksOpen "$DEV" "$CRYPTROOT_NAME" --key-file "$TMP_KEY" 2>"$_gpg_open_log"; then
      unlock_ok=true
      dbg "cryptsetup luksOpen succeeded via GPG token"
    else
      dbg "cryptsetup luksOpen failed after successful GPG token decrypt"
      dbg_log_file_lines "cryptsetup: " "$_gpg_open_log"
    fi
    rm -f "$_gpg_open_log"
  else
    dbg "gpg token decrypt failed for selector $KEY_SPEC"
  fi
  rm -f "${BLOB:-}"

  if [ "$unlock_ok" = true ]; then
    rm -f "$TMP_KEY"
    set_debug_summary "success" "gpg-unlock"
    exit 0
  fi

  msg "GPG decrypt failed"
  if [ "$SMARTCARD_EXPECT" = "1" ]; then
    if prompt_skip_or_wait; then
      rm -f "$TMP_KEY"
      msg "bypassing GPG smartcard; continuing to standard cryptroot fallback"
      set_debug_summary "fallback" "user-skipped-after-gpg-failure"
      exit 0
    fi
    msg "smartcard detected; retrying GPG unlock"
    if command -v gpgconf >/dev/null 2>&1; then
      gpgconf --kill scdaemon 2>/dev/null || true
    fi
    continue
  fi

  rm -f "$TMP_KEY"
  msg "GPG flow failed in non-interactive mode; continuing to standard cryptroot fallback"
  set_debug_summary "fallback" "gpg-failed-noninteractive"
  exit 0
done