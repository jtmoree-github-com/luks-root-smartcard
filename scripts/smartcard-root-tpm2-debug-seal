#!/bin/bash
# smartcard-root-tpm2-debug-seal: Manage TPM2-sealed debug flag for UKI
#
# This script handles the complete lifecycle of the TPM2-sealed debug flag:
#  - Create/seal: Bind debug flag to system PCR measurements
#  - Enable/disable: Toggle debug without UKI rebuild
#  - Rotate: Update PCR policy when kernel/firmware changes
#  - Audit: Check current debug seal status
#
# Requires: tpm2-tools
# Runs as: root (for TPM device access)
#
# Usage:
#   smartcard-root-tpm2-debug-seal create    [--pcr=7,11,12] [--force]
#   smartcard-root-tpm2-debug-seal enable
#   smartcard-root-tpm2-debug-seal disable
#   smartcard-root-tpm2-debug-seal status
#   smartcard-root-tpm2-debug-seal rotate    [--pcr=7,11,12]
#   smartcard-root-tpm2-debug-seal audit

set -eu

# Configuration
SMARTCARD_DEBUG_STATE_DIR="${SMARTCARD_DEBUG_STATE_DIR:-/etc/smartcard-root-debug}"
SMARTCARD_DEBUG_NV_INDEX="0x1000001"
SMARTCARD_DEBUG_TPM_HANDLE="0x81000001"
SMARTCARD_DEBUG_PRIMARY_CTX="/tmp/smartcard_debug_primary.ctx"
SMARTCARD_DEBUG_POLICY_CTX="/tmp/smartcard_debug_policy.ctx"
SMARTCARD_DEBUG_SEALED_CTX="/tmp/smartcard_debug_sealed.ctx"
DEFAULT_PCRS="7,11"
DEBUG_FLAG_MESSAGE="SMARTCARD_ROOT_DEBUG_TPM2_SEAL"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
  echo -e "${BLUE}[INFO]${NC} $*" >&2
}

log_success() {
  echo -e "${GREEN}[SUCCESS]${NC} $*" >&2
}

log_warn() {
  echo -e "${YELLOW}[WARN]${NC} $*" >&2
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $*" >&2
}

die() {
  log_error "$@"
  exit 1
}

require_root() {
  if [ "$EUID" -ne 0 ]; then
    die "This command requires root privileges"
  fi
}

check_prerequisites() {
  local missing_tools=()
  
  for tool in tpm2_unseal tpm2_pcrread tpm2_createprimary tpm2_create tpm2_evictcontrol tpm2_readpublic; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      missing_tools+=("$tool")
    fi
  done
  
  if [ ${#missing_tools[@]} -gt 0 ]; then
    die "Missing required tools: ${missing_tools[*]}. Install tpm2-tools package."
  fi
  
  if [ ! -c /dev/tpm0 ] && [ ! -c /dev/tpmrm0 ]; then
    die "TPM device not found. Check TPM is enabled in BIOS and supported by kernel."
  fi
}

verify_tpm_access() {
  if ! tpm2_getcap handles-persistent 2>/dev/null | grep -q "$SMARTCARD_DEBUG_TPM_HANDLE"; then
    return 1  # Handle not yet persistent
  fi
  return 0
}

create_seal() {
  local pcrs="${1:-$DEFAULT_PCRS}"
  local force="${2:-0}"
  
  require_root
  check_prerequisites
  
  log_info "Creating TPM2-sealed debug flag (PCRs: $pcrs)"
  
  # Check if seal already exists
  if verify_tpm_access; then
    if [ "$force" != "1" ]; then
      log_warn "Debug seal already exists at handle $SMARTCARD_DEBUG_TPM_HANDLE"
      log_info "Use --force to recreate, or use 'enable'/'disable' to toggle"
      return 1
    fi
    log_info "Force flag set; clearing existing seal..."
    tpm2_evictcontrol -C o "$SMARTCARD_DEBUG_TPM_HANDLE" 2>/dev/null || true
  fi
  
  # Create state directory
  mkdir -p "$SMARTCARD_DEBUG_STATE_DIR"
  chmod 700 "$SMARTCARD_DEBUG_STATE_DIR"
  
  log_info "Step 1: Reading current PCR values ($pcrs)..."
  if ! tpm2_pcrread -o /tmp/pcr_state_"$$.bin" "sha256:$pcrs"; then
    die "Failed to read PCR values. Check TPM is accessible."
  fi
  
  log_info "Step 2: Creating PCR policy..."
  if ! tpm2_pcrread -l "sha256:$pcrs" -L "$SMARTCARD_DEBUG_POLICY_CTX"; then
    die "Failed to create PCR policy"
  fi
  
  log_info "Step 3: Creating TPM primary context..."
  if ! tpm2_createprimary -C e -g sha256 -G rsa -c "$SMARTCARD_DEBUG_PRIMARY_CTX"; then
    die "Failed to create primary context"
  fi
  
  log_info "Step 4: Sealing debug flag with PCR policy..."
  echo -n "$DEBUG_FLAG_MESSAGE" | \
    tpm2_create \
      -C "$SMARTCARD_DEBUG_PRIMARY_CTX" \
      -L "$SMARTCARD_DEBUG_POLICY_CTX" \
      -i - \
      -c "$SMARTCARD_DEBUG_SEALED_CTX" \
      -o "$SMARTCARD_DEBUG_STATE_DIR/debug_sealed.priv" || die "Failed to seal debug flag"
  
  log_info "Step 5: Persisting seal to TPM handle $SMARTCARD_DEBUG_TPM_HANDLE..."
  if ! tpm2_evictcontrol -C o -c "$SMARTCARD_DEBUG_SEALED_CTX" "$SMARTCARD_DEBUG_TPM_HANDLE"; then
    die "Failed to persist seal to TPM"
  fi
  
  # Save metadata
  cat > "$SMARTCARD_DEBUG_STATE_DIR/seal_metadata.txt" <<EOF
Created: $(date -u -Iseconds)
PCRs: $pcrs
TPM Handle: $SMARTCARD_DEBUG_TPM_HANDLE
Status: enabled
EOF
  
  # Save PCR state for reference
  cp /tmp/pcr_state_"$$.bin" "$SMARTCARD_DEBUG_STATE_DIR/pcr_state_at_creation.bin"
  
  # Cleanup temp files
  rm -f "$SMARTCARD_DEBUG_PRIMARY_CTX" "$SMARTCARD_DEBUG_POLICY_CTX" "$SMARTCARD_DEBUG_SEALED_CTX" /tmp/pcr_state_"$$.bin"
  
  log_success "Debug seal created successfully!"
  log_info "Debug is now ENABLED. Unseal will succeed on next boot."
  log_info "Metadata saved to: $SMARTCARD_DEBUG_STATE_DIR/seal_metadata.txt"
}

enable_debug() {
  require_root
  check_prerequisites
  
  if ! verify_tpm_access; then
    die "Debug seal not found. Run 'create' first."
  fi
  
  # Current implementation: seal is always "enabled" when it can be unsealed
  # This is a placeholder for future logic (e.g., NV index toggle)
  log_success "Debug seal is accessible and will be checked on next boot"
  log_info "To verify it works, unseal the flag: tpm2_unseal -c $SMARTCARD_DEBUG_TPM_HANDLE"
}

disable_debug() {
  require_root
  
  if [ ! -c /dev/tpm0 ] && [ ! -c /dev/tpmrm0 ]; then
    die "TPM device not found"
  fi
  
  if ! verify_tpm_access; then
    log_warn "Debug seal not found; nothing to disable"
    return 0
  fi
  
  log_info "Removing debug seal from TPM persistent storage..."
  if tpm2_evictcontrol -C o "$SMARTCARD_DEBUG_TPM_HANDLE" 2>/dev/null; then
    log_success "Debug seal removed. Debug will be disabled on next boot."
  else
    log_warn "Could not remove seal (may require TPM ownership reset)"
  fi
}

status_debug() {
  log_info "Debug Seal Status"
  log_info "================="
  
  if [ -d "$SMARTCARD_DEBUG_STATE_DIR" ]; then
    log_info "State directory: $SMARTCARD_DEBUG_STATE_DIR"
    
    if [ -f "$SMARTCARD_DEBUG_STATE_DIR/seal_metadata.txt" ]; then
      log_info "Metadata:"
      sed 's/^/  /' "$SMARTCARD_DEBUG_STATE_DIR/seal_metadata.txt"
    fi
  else
    log_info "State directory not found (seal may not be initialized)"
  fi
  
  if verify_tpm_access 2>/dev/null; then
    log_success "✓ Debug seal is present in TPM (handle $SMARTCARD_DEBUG_TPM_HANDLE)"
    
    # Try to unseal and show result
    if tpm2_unseal -c "$SMARTCARD_DEBUG_TPM_HANDLE" 2>/dev/null | grep -q "$DEBUG_FLAG_MESSAGE"; then
      log_success "✓ Seal unsealed successfully (debug ENABLED)"
    else
      log_warn "⚠ Seal exists but unseal verification failed"
    fi
  else
    log_warn "✗ Debug seal not found in TPM"
  fi
  
  # Show current PCR values
  log_info ""
  log_info "Current PCR Values:"
  tpm2_pcrread sha256 2>/dev/null | head -20 || log_warn "Could not read PCRs"
}

rotate_seal() {
  local new_pcrs="${1:-$DEFAULT_PCRS}"
  
  require_root
  
  log_info "Rotating debug seal with new PCR policy..."
  log_info "This updates the seal to match current system state"
  log_info ""
  log_info "Old PCRs: (from metadata)"
  
  if [ -f "$SMARTCARD_DEBUG_STATE_DIR/seal_metadata.txt" ]; then
    grep "^PCRs:" "$SMARTCARD_DEBUG_STATE_DIR/seal_metadata.txt" || log_warn "Could not read old PCRs"
  fi
  
  log_info "New PCRs: $new_pcrs"
  log_info ""
  log_warn "⚠ Rotating will disable debug until the new seal is created"
  log_info "Backing up old seal data..."
  
  # Backup current state
  if [ -d "$SMARTCARD_DEBUG_STATE_DIR" ]; then
    backup_dir="$SMARTCARD_DEBUG_STATE_DIR/backup_$(date +%s)"
    mkdir -p "$backup_dir"
    cp -r "$SMARTCARD_DEBUG_STATE_DIR"/* "$backup_dir/" 2>/dev/null || true
    log_info "Backup saved to: $backup_dir"
  fi
  
  # Recreate seal with new PCRs
  disable_debug || true
  create_seal "$new_pcrs" 1
  
  log_success "Debug seal rotated successfully"
  log_info "Backup available at: ${backup_dir:-N/A}"
}

audit_seal() {
  log_info "Debug Seal Audit"
  log_info "================"
  
  if [ ! -c /dev/tpm0 ] && [ ! -c /dev/tpmrm0 ]; then
    log_warn "TPM device not found; cannot audit"
    return 1
  fi
  
  log_info "TPM Persistent Handles:"
  tpm2_getcap handles-persistent 2>/dev/null | grep -E "(0x81000001|smartcard)" || log_info "No smartcard debug handles found"
  
  log_info ""
  log_info "TPM Event Log (last 10 debug-related entries):"
  if [ -r /sys/kernel/security/tpm0/ascii_bios_measurements ]; then
    grep -i "debug\|pcr" /sys/kernel/security/tpm0/ascii_bios_measurements | tail -10 || log_info "No debug entries in event log"
  else
    log_warn "Cannot read TPM event log; check permissions"
  fi
  
  log_info ""
  log_info "Integrity Check:"
  if verify_tpm_access 2>/dev/null; then
    if tpm2_readpublic -c "$SMARTCARD_DEBUG_TPM_HANDLE" >/dev/null 2>&1; then
      log_success "✓ Debug seal integrity verified"
    else
      log_warn "⚠ Could not verify seal integrity"
    fi
  else
    log_warn "✗ Debug seal not accessible"
  fi
}

print_help() {
  cat <<EOF
smartcard-root-tpm2-debug-seal - TPM2 Debug Flag Manager for UKI

Usage: smartcard-root-tpm2-debug-seal <command> [options]

Commands:
  create [--pcr=PCRs] [--force]
      Create and seal debug flag to current system state.
      PCRs default to 7,11 (Secure Boot + UKI measurement).
      --force: Recreate even if seal exists.
      
  enable
      Mark debug as enabled (seal will be checked on boot).
      
  disable
      Remove debug seal from TPM (disables debug on next boot).
      
  status
      Show current seal status, metadata, and PCR values.
      
  rotate [--pcr=PCRs]
      Update seal after kernel/firmware changes.
      Rotates to new PCR policy while backing up old seal.
      
  audit
      Detailed audit: persistent handles, event log, integrity.

Examples:
  # Initial setup (after first boot)
  sudo smartcard-root-tpm2-debug-seal create
  
  # Check if debug is enabled
  sudo smartcard-root-tpm2-debug-seal status
  
  # Rotate after kernel update
  sudo smartcard-root-tpm2-debug-seal rotate
  
  # Disable debug without rebuild
  sudo smartcard-root-tpm2-debug-seal disable
  
  # Full audit
  sudo smartcard-root-tpm2-debug-seal audit

PCR Reference (for UKI):
  7  - Secure Boot state, MOK
  11 - systemd unified kernel image measurement
  12 - Kernel command line (alternative to 11)

Typical Policy: 7,11 (most common and secure for UKI)

State Directory: $SMARTCARD_DEBUG_STATE_DIR

EOF
}

# Main
main() {
  local cmd="${1:-}"
  shift || true
  
  case "$cmd" in
    create)
      local pcrs="$DEFAULT_PCRS"
      local force=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --pcr=*) pcrs="${1#--pcr=}" ;;
          --force) force=1 ;;
          *) log_warn "Unknown option: $1" ;;
        esac
        shift
      done
      create_seal "$pcrs" "$force"
      ;;
    enable)
      enable_debug
      ;;
    disable)
      disable_debug
      ;;
    status)
      status_debug
      ;;
    rotate)
      local pcrs="$DEFAULT_PCRS"
      while [ $# -gt 0 ]; do
        case "$1" in
          --pcr=*) pcrs="${1#--pcr=}" ;;
          *) log_warn "Unknown option: $1" ;;
        esac
        shift
      done
      rotate_seal "$pcrs"
      ;;
    audit)
      audit_seal
      ;;
    -h|--help|help)
      print_help
      ;;
    "")
      print_help
      exit 0
      ;;
    *)
      log_error "Unknown command: $cmd"
      print_help
      exit 1
      ;;
  esac
}

main "$@"
