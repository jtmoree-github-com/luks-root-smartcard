#!/bin/sh
set -eu

for f in \
	/usr/sbin/gpg-cryptenroll \
	/usr/sbin/gpg-cryptopen \
	/usr/sbin/gpg-cryptmount
do
	sh -n "$f"
done

for f in \
	initramfs/local-top/05-smartcard-root-fido2 \
	initramfs/local-top/10-smartcard-root-pkcs11 \
	initramfs/local-top/20-smartcard-root-gpg
do
	grep -q "plymouth --hide-splash" "$f" || {
		echo "missing plymouth splash workaround in $f" >&2
		exit 1
	}
done

# Ensure the GPG unlock path explicitly switches to a text console before
# pinentry/gpg prompts and resets gpg-agent/scdaemon state between retries.
if ! grep -q "prepare_prompt_console" initramfs/local-top/20-smartcard-root-gpg; then
	echo "missing prepare_prompt_console call in GPG boot script" >&2
	exit 1
fi
if ! grep -q "gpgconf --kill gpg-agent" initramfs/local-top/20-smartcard-root-gpg; then
	echo "missing gpg-agent reset in GPG boot script" >&2
	exit 1
fi
if grep -q -- "--pinentry-mode loopback" initramfs/local-top/20-smartcard-root-gpg; then
	echo "GPG boot script must not force loopback pinentry mode" >&2
	exit 1
fi

PKCS11_SRC="initramfs/local-top/10-smartcard-root-pkcs11"
PKCS11_INST="/usr/share/initramfs-tools/scripts/local-top/10-smartcard-root-pkcs11"

if [ -f "$PKCS11_INST" ]; then
	for pat in \
		'^get_token_field()' \
		'^pkcs11_uri_id_to_hex()' \
		'base64 -w0 < "\$TMP_KEY" > "\$TMP_B64"' \
		'cryptsetup luksOpen "\$DEV" "\$CRYPTROOT_NAME" --key-file "\$TMP_B64"'
	do
		grep -q "$pat" "$PKCS11_INST" || {
			echo "installed PKCS#11 script missing pattern: $pat" >&2
			exit 1
		}
	done

	if [ -f "$PKCS11_SRC" ]; then
		cmp -s "$PKCS11_SRC" "$PKCS11_INST" || {
			echo "installed PKCS#11 script differs from source; rebuild/install newest package" >&2
			exit 1
		}
	fi
fi

# Ensure every hook honors the SMARTCARD_INITRAMFS_INCLUDE toggle.
for f in \
	initramfs/hooks/smartcard-root-tpm2 \
	initramfs/hooks/smartcard-root-fido2 \
	initramfs/hooks/smartcard-root-pkcs11 \
	initramfs/hooks/smartcard-root-gpg
do
	grep -q "SMARTCARD_INITRAMFS_INCLUDE" "$f" || {
		echo "missing SMARTCARD_INITRAMFS_INCLUDE toggle in $f" >&2
		exit 1
	}
done

echo "helper script syntax checks passed"
